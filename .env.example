# Адрес Django для dev-прокси (vite dev server)
BACKEND_URL=http://127.0.0.1:8000
# Откуда Django отдаёт статику сборки
VITE_ASSETS_BASE=/assets/chat_legacy/
# URL страницы чата для dev (в проде — data-base="/messenger/" у #root в шаблоне)
VITE_ROUTER_BASE=/
# Базовый путь REST API (все эндпоинты чата, включая auth)
VITE_API_BASE=/api/v1/chat
# Хост для WebSocket; пусто — текущий location.host
VITE_WS_HOST=
# Ручка текущего пользователя сайта
VITE_SELF_URL=/api/v1/users/session/self/
# Часовой пояс сервера для дат без смещения
VITE_SERVER_UTC_OFFSET=+03:00
# Отправлять текст в HTML-формате редактора сайта (<p>..</p>); false — простой текст
VITE_SEND_HTML=true
# Только для разработки: cookie сессии для работы с боевым бэкендом через прокси.
# Хранить в .env.local (он в .gitignore), например:
# BACKEND_URL=https://alterlit.ru
# DEV_COOKIE=csrftoken=...; alterlitsessionid=...
# Ссылка на профиль пользователя на сайте, {username} — логин
VITE_PROFILE_URL=https://alterlit.ru/profile/{username}/
